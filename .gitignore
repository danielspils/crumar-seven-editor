# Dependencies
node_modules/

# Build output
dist/
out/

# Intermediates from tools/build-icons.py; the containers it produces are
# committed, the loose PNGs are not.
build/.icons/

# build/ is INPUT, not output: electron-builder reads it as buildResources.
# The icon and the entitlements have to be in the repo or a CI build produces
# an app with the default Electron logo and no hardened-runtime exceptions.
!build/

# Logs
*.log
npm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# NOTE: captures/ is intentionally NOT ignored.
# Raw MIDI logs are the project's ground truth (Rule 2) and must be tracked.

# Secrets — never commit a raw globals dump (Rule 6).
# The globals reply carries wfp, the instrument's Wi-Fi password in plaintext.
# Redaction is enforced in code; these patterns are a backstop only.
*globals*.raw
*globals*.dump
*.globals.json
raw-globals*

# Scratch HTML a Claude session drops in the repo root while working — one-off
# prototypes and mock-ups, the same kind of thing out/ holds. Ignored rather
# than deleted: it is working material, and a prototype that turns out to be
# worth keeping should be MOVED somewhere tracked (as the release list and the
# save spec both were) rather than committed from here.
Claude outputs/
